# Copy to .env (never commit it) or export these in your shell.
# Nothing here is required: without credentials the QPU path runs on a local IBM-device emulator.

# --- IBM Quantum (free Open Plan: 10 QPU-minutes per 28 days) ---
# Create an account at https://quantum.cloud.ibm.com, then copy your API key.
QISKIT_IBM_TOKEN=
# Optional: instance CRN or name, and a specific device (default: least busy)
QISKIT_IBM_INSTANCE=
IBM_QUANTUM_BACKEND=

# --- Amazon Braket (QPUs are billed per task and per shot) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Setting this is the opt-in. Examples:
#   arn:aws:braket:::device/quantum-simulator/amazon/sv1   (managed simulator, free tier eligible)
#   arn:aws:braket:eu-north-1::device/qpu/iqm/Garnet       (real QPU)
BRAKET_DEVICE_ARN=

# --- Safety caps for real hardware ---
QEDGE_HW_MAX_CIRCUITS=60
QEDGE_HW_MAX_SHOTS=2000
